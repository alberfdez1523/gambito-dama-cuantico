{
  "name": "gambito-dama-cuantico-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:flags": "playwright test --config=playwright.flags.config.ts",
    "e2e:pwa": "npm run build && playwright test --config=playwright.pwa.config.ts",
    "e2e:visual": "playwright test e2e/game.spec.ts",
    "check:smoke": "node --check ../scripts/multiplayer-smoke.mjs",
    "check:bundle": "node ../scripts/check-bundle-size.mjs",
    "smoke:multiplayer": "node ../scripts/multiplayer-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "chess.js": "1.4.0",
    "framer-motion": "11.18.2",
    "idb": "8.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
