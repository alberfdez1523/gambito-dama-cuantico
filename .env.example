# Backend / API
PORT=8000
SKIP_STOCKFISH=0
STOCKFISH_POOL_SIZE=2
STOCKFISH_QUEUE_TIMEOUT=3

# Límite de peticiones por IP y minuto (0 en RATE_LIMIT_ENABLED lo desactiva).
RATE_LIMIT_ENABLED=1
RATE_LIMIT_ENGINE_PER_MINUTE=60
RATE_LIMIT_ANALYTICS_PER_MINUTE=120
RATE_LIMIT_API_PER_MINUTE=240
# IPs de proxies en las que confiar para X-Forwarded-For ("*" detrás de Render).
FORWARDED_ALLOW_IPS=127.0.0.1
# Orígenes permitidos por CORS separados por comas. Vacío = solo mismo origen.
CORS_ORIGINS=

# Verificación de tokens Supabase. Se acepta SUPABASE_ANON_KEY como fallback,
# pero se recomienda la publishable key actual. Nunca expongas service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTH_CACHE_SECONDS=120

# Solo para pruebas detrás de un proxy local de confianza.
TRUST_AUTH_PROXY=0

# Mantener apagado hasta compartir el Game Core con el servidor y superar carga.
FEATURE_AUTHORITATIVE_QUANTUM=0
